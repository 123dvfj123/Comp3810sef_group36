<%- include("partials/header", { title }) %>

<section class="login-layout">
  <div class="login-copy">
    <p class="eyebrow">Customer experience</p>
    <h1>Drive something<br>worth remembering.</h1>
    <p class="lead">Choose a specific vehicle, review the details, and start your rental immediately.</p>
  </div>

  <section class="panel login-panel" aria-labelledby="login-title">
    <p class="eyebrow">Customer access</p>
    <h2 id="login-title">Sign in</h2>
    <p class="muted">Use one of the two preset demo accounts.</p>

    <% if (error) { %>
      <div class="form-alert" role="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/login" class="form-stack">
      <label>
        <span>Username</span>
        <input name="username" value="<%= username %>" autocomplete="username" required>
      </label>
      <label>
        <span>Password</span>
        <input type="password" name="password" autocomplete="current-password" required>
      </label>
      <button class="button button-primary button-wide" type="submit">Enter FleetDesk</button>
    </form>

    <div class="demo-accounts">
      <strong>Demo accounts</strong>
      <code>customer01 / demo123</code>
      <code>customer02 / demo123</code>
    </div>
  </section>
</section>

<%- include("partials/footer") %>
