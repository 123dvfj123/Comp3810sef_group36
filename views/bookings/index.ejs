<%- include("../partials/header", { title }) %>

<section class="page-hero compact">
  <div>
    <h1>My bookings</h1>
  </div>
  <a class="button button-secondary" href="/cars">Browse cars</a>
</section>

<% if (bookings.length === 0) { %>
  <section class="empty-state">
    <h2>No bookings yet.</h2>
    <p>Your first rental will appear here after you choose a car.</p>
    <a class="button button-primary" href="/cars">Browse the collection</a>
  </section>
<% } else { %>
  <section class="booking-list">
    <% bookings.forEach((booking) => { const overdue = isOverdue(booking, now); %>
      <article class="booking-row">
        <div>
          <p class="eyebrow">Booking ID: <%= booking.id %></p>
          <h2><%= booking.carModel %></h2>
          <p class="muted"><%= booking.plateNo %> · <%= dateTime(booking.pickupAt) %></p>
        </div>
        <div class="booking-meta">
          <span class="status-chip <%= overdue ? "overdue" : booking.status %>"><%= overdue ? "Overdue" : booking.status %></span>
          <strong>HKD <%= money(booking.totalAmount) %></strong>
          <span><%= booking.rentalDays %> day<%= booking.rentalDays === 1 ? "" : "s" %></span>
        </div>
        <a class="button button-quiet" href="/bookings/<%= booking.id %>">Open</a>
      </article>
    <% }); %>
  </section>
<% } %>

<%- include("../partials/footer") %>
